# ============================================================
# Enterprise AI Ops Agent - 环境变量模板
# 复制本文件为 .env 后再填写本地真实配置；切勿将 .env 提交到 Git
# ============================================================

# 应用基础配置
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 大模型配置：
# - 离线演示/免 Key 单测：LLM_PROVIDER=mock
# - 接入 DeepSeek：LLM_PROVIDER=deepseek，并填入你的真实 LLM_API_KEY
# - 接入其他 OpenAI 兼容接口（通义千问 / Ollama / vLLM）：LLM_PROVIDER=openai_compatible
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# 向量数据库配置（与 docker-compose.yml 默认值一致）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_ai_ops

# 安全与审计配置
ENABLE_AUDIT_LOG=true
MAX_QUERY_LENGTH=1000
